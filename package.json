{
  "name": "clip-js",
  "version": "0.2.0",
  "description": "A lightweight, reusable JavaScript AI assistant widget with pluggable AI/RAG backends, suggested questions, theming, responsive UI, and the Clip mascot.",
  "type": "module",
  "license": "UNLICENSED",
  "author": "Athinodoros Boudourakis",
  "keywords": [
    "ai",
    "assistant",
    "chat",
    "widget",
    "rag",
    "chatbot"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/clip-js.umd.cjs",
  "module": "./dist/clip-js.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/clip-js.js",
      "require": "./dist/clip-js.umd.cjs"
    },
    "./styles.css": "./dist/clip-js.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "optimize:mascot": "node scripts/optimize-mascot.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
